{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Metrics: current file",
            "request": "launch",
            "mainClass": "io.github.kkami121.codeanalyzer.Main",
            "args": "metrics ${file}"
        },
        {
            "type": "java",
            "name": "Decaf: program3.decaf",
            "request": "launch",
            "mainClass": "io.github.kkami121.codeanalyzer.Main",
            "args": "tokens ${workspaceFolder}/src/test/resources/decaf/program3.decaf --format decaf"
        },
        {
            "type": "java",
            "name": "REST API server (port 8080)",
            "request": "launch",
            "mainClass": "io.github.kkami121.codeanalyzer.Main",
            "args": "serve --port 8080"
        }
    ]
}
